# Plantilla de configuración de Benechito.
# Copia este archivo como `.env` y reemplaza los valores por los tuyos.
# NUNCA subas tu `.env` real a GitHub (ya está ignorado).

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/benechito?schema=public"

# --- Sesión / seguridad ---
# Cadena larga y aleatoria (ej: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-aleatoria"

# --- Usuario admin inicial (se crea con `npm run seed`) ---
SEED_ADMIN_EMAIL="admin@benechito.com"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
SEED_ADMIN_NOMBRE="Equipo Benechito"

# --- WhatsApp del negocio (formato internacional, sin +) ---
NEXT_PUBLIC_WHATSAPP="56912345678"

# --- Evolution API (WhatsApp) — normalmente vive en n8n, no en la app ---
EVOLUTION_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="benechito"
NOTIFY_WHATSAPP=""

# --- n8n (automatización) ---
# Webhook que recibe un prospecto nuevo → envía WhatsApp
N8N_WEBHOOK_URL="http://localhost:5678/webhook/nuevo-prospecto"
# Webhook de preventa: recibe {telefono, nombre, mensaje} → Evolution sendText
N8N_PREVENTA_WEBHOOK_URL=""

# --- Tienda online / Mercado Pago (pago con tarjeta en /tienda) ---
# URL pública de tu app (para los back_urls y el webhook de pago). Ej: https://benechito.com
APP_URL=""
# Access Token de Mercado Pago (Credenciales de producción). Lo obtienes en tu cuenta MP.
# Si lo dejas vacío, la tienda funciona igual pero SIN pago en línea (tomas el pedido y cobras aparte).
MERCADOPAGO_ACCESS_TOKEN=""

# --- Reporte diario (socio digital) ---
# Protege el endpoint /api/reporte/diario. n8n debe enviar el mismo token.
# Si lo dejas vacío, el endpoint queda abierto (ok en local, ponlo en producción).
REPORTE_TOKEN="benechito-reporte-2026"

# --- Aviso por Telegram (pedido nuevo, etc.) ---
# Bot de Telegram del negocio. Con esto, cada pedido web te avisa al instante.
# TELEGRAM_BOT_TOKEN = el token del bot (@BotFather). TELEGRAM_CHAT_ID = tu id (@userinfobot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Extensión Facturación (LibreDTE + n8n) ---
# app -> n8n (dispara la emisión al cerrar boleta/factura)
SII_N8N_WEBHOOK_URL="https://tu-n8n/webhook/facturacion"
SII_N8N_WEBHOOK_TOKEN="cambia-esto"
# n8n -> app (escribe folio/PDF/estado en el documento)
SII_WEBHOOK_TOKEN="cambia-esto-tambien"
# LibreDTE (self-host en Hostinger o nube https://libredte.cl/api)
LIBREDTE_API_URL="https://libredte.tudominio.cl/api"
LIBREDTE_RUT_EMISOR="76123456-9"
