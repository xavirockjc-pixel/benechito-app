# ─────────────────────────────────────────────────────────────────────────────
#  Da'cris — variables de la instancia (la app + la central)
#  Copia este archivo como .env en el servicio de Da'cris y ajusta los valores.
#  NUNCA subas el .env real al repo (va con claves).
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos Postgres de la instancia de Da'cris (una base solo para Da'cris)
DATABASE_URL="postgresql://dacris:CAMBIA_ESTA_CLAVE@postgres:5432/dacris"

# Sesión / seguridad (genera un secreto largo y aleatorio)
AUTH_SECRET="CAMBIA_POR_UN_SECRETO_LARGO_ALEATORIO"
NEXTAUTH_URL="https://dacris.tu-dominio.cl"

# Dueño / admin que crea la semilla (la central)
DACRIS_ADMIN_EMAIL="dueno@dacris.cl"
DACRIS_ADMIN_PASSWORD="CAMBIA_ESTA_CLAVE"
DACRIS_ADMIN_NOMBRE="Dueño Da'cris"
# Clave por defecto para cajero/cocina/reparto (cámbialas luego desde la central)
DACRIS_PASS="CAMBIA_ESTA_CLAVE"

# Marca / contacto del negocio (para reportes y tienda)
NEGOCIO_NOMBRE="Da'cris"
NEGOCIO_WHATSAPP="56937762665"
NEGOCIO_DIRECCION="Av. La Paz 99, Lota"

# Pagos (opcional — solo si Da'cris cobra online). Deja vacío si no aplica.
MERCADOPAGO_ACCESS_TOKEN=""

# Notificaciones / reporte diario (opcional, según lo que use la instancia)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
