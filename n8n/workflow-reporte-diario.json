{
  "id": "benechitoReporte001",
  "name": "Benechito · Reporte diario → WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * *" }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Cada día 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/reporte/diario",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "token", "value": "benechito-reporte-2026" }
          ]
        },
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000002",
      "name": "Generar reporte (app)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://evolution:8080/message/sendText/benechito",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "benechito-evo-key-2026" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"56965813188\",\n  \"text\": {{ JSON.stringify($json.texto) }}\n}",
        "options": {}
      },
      "id": "a3000000-0000-4000-8000-000000000003",
      "name": "Enviar WhatsApp (Evolution)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 300]
    }
  ],
  "connections": {
    "Cada día 8:00": {
      "main": [[{ "node": "Generar reporte (app)", "type": "main", "index": 0 }]]
    },
    "Generar reporte (app)": {
      "main": [[{ "node": "Enviar WhatsApp (Evolution)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
