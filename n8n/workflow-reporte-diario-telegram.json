{
  "name": "Benechito · Reporte diario → Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 8 * * *" } ] }
      },
      "id": "t1000000-0000-4000-8000-000000000001",
      "name": "Cada día 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://benechito.com/api/reporte/diario",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "token", "value": "benechito-reporte-2026" } ] },
        "options": {}
      },
      "id": "t2000000-0000-4000-8000-000000000002",
      "name": "Generar reporte (app)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "chatId": "REEMPLAZA_CHAT_ID",
        "text": "={{ $json.texto }}",
        "additionalFields": {}
      },
      "id": "t3000000-0000-4000-8000-000000000003",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 300],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Benechito" } }
    }
  ],
  "connections": {
    "Cada día 8:00": { "main": [[{ "node": "Generar reporte (app)", "type": "main", "index": 0 }]] },
    "Generar reporte (app)": { "main": [[{ "node": "Enviar a Telegram", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
