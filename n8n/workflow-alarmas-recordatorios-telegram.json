{
  "name": "Benechito · Alarmas de recordatorios (hora) → Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 8-22 * * *" } ] }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Cada hora 8:00-22:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://benechito.com/api/recordatorios/alarmas",
        "sendQuery": true,
        "queryParameters": { "parameters": [ { "name": "token", "value": "benechito-reporte-2026" } ] },
        "options": {}
      },
      "id": "a2000000-0000-4000-8000-000000000002",
      "name": "Buscar alarmas de la hora",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "id": "cond-total", "leftValue": "={{ $json.total }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3000000-0000-4000-8000-000000000003",
      "name": "¿Hay algo que avisar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [980, 300]
    },
    {
      "parameters": {
        "chatId": "REEMPLAZA_CHAT_ID",
        "text": "={{ $json.texto }}",
        "additionalFields": {}
      },
      "id": "a4000000-0000-4000-8000-000000000004",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1260, 220],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Benechito" } }
    }
  ],
  "connections": {
    "Cada hora 8:00-22:00": { "main": [[{ "node": "Buscar alarmas de la hora", "type": "main", "index": 0 }]] },
    "Buscar alarmas de la hora": { "main": [[{ "node": "¿Hay algo que avisar?", "type": "main", "index": 0 }]] },
    "¿Hay algo que avisar?": { "main": [[{ "node": "Enviar a Telegram", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
